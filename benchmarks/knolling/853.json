    "cnf": "(forall ?s (exists ?c (exists ?h (exists ?r (exists ?d (and (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Is ?c 'cutting_board')) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Below ?c ?s)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Is ?h 'headphones')) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (AlignedHorizontally ?c ?h)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Is ?d 'screwdriver')) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Below ?h ?s)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Is ?r 'remote')) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (LargerThan ?s ?c)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Below ?d ?s)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (AlignedHorizontally ?h ?r)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (Below ?r ?s)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (AlignedHorizontally ?r ?d)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (SmallerThan ?d ?r)) (or (not (Is ?s 'suitcase')) (not (OnTopSide ?s)) (OnRightSide ?d))))))))",
    "k": 5,
