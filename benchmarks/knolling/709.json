    "cnf": "(exists ?backpack (forall ?sandwich (exists ?cutting_board (exists ?pizza (and (Is ?backpack 'backpack') (OnBottomSide ?backpack) (or (not (Is ?sandwich 'sandwich')) (Above ?cutting_board ?backpack)) (or (not (Is ?sandwich 'sandwich')) (LargerThan ?backpack ?sandwich)) (or (not (Is ?sandwich 'sandwich')) (Is ?cutting_board 'cutting_board')) (or (not (Is ?sandwich 'sandwich')) (RightOf ?pizza ?cutting_board)) (or (not (Is ?sandwich 'sandwich')) (Is ?pizza 'pizza')) (or (not (Is ?sandwich 'sandwich')) (Above ?sandwich ?pizza)))))))",
    "k": 4,
    "object_classes": [
        "sandwich",
