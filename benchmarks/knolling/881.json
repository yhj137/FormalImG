    "cnf": "(exists ?suitcase (forall ?sock (exists ?shirt (exists ?remote (exists ?pen (and (Is ?suitcase 'suitcase') (OnLeftSide ?suitcase) (or (not (Is ?sock 'sock')) (AlignedVertically ?sock ?suitcase)) (or (not (Is ?sock 'sock')) (LeftOf ?pen ?suitcase)) (or (not (Is ?sock 'sock')) (LeftOf ?shirt ?sock)) (or (not (Is ?sock 'sock')) (AlignedVertically ?remote ?shirt)) (or (not (Is ?sock 'sock')) (OnBottomSide ?pen)) (or (not (Is ?sock 'sock')) (Is ?pen 'pen')) (or (not (Is ?sock 'sock')) (Is ?shirt 'shirt')) (or (not (Is ?sock 'sock')) (Is ?remote 'remote'))))))))",
    "k": 5,
