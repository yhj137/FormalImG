    "cnf": "(forall ?h (exists ?c (exists ?v (and (or (not (Is ?h 'headphones')) (not (Has ?h 'black')) (Is ?c 'cup')) (or (not (Is ?h 'headphones')) (not (Has ?h 'black')) (Has ?c 'white')) (or (not (Is ?h 'headphones')) (not (Has ?h 'black')) (Below ?c ?h)) (or (not (Is ?h 'headphones')) (not (Has ?h 'black')) (Is ?v 'carrot')) (or (not (Is ?h 'headphones')) (not (Has ?h 'black')) (AlignedVertically ?h ?c)) (or (not (Is ?h 'headphones')) (not (Has ?h 'black')) (AlignedHorizontally ?c ?v))))))",
    "k": 3,
    "object_classes": [
        "carrot",
        "headphones",
        "cup"
    ]
}