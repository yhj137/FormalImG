    "cnf": "(exists ?stapler (forall ?controller (exists ?lighter (and (Is ?stapler 'stapler') (OnLeftSide ?stapler) (or (not (Is ?controller 'game_controller')) (RightOf ?controller ?stapler)) (or (not (Is ?controller 'game_controller')) (AlignedHorizontally ?stapler ?controller)) (or (not (Is ?controller 'game_controller')) (Is ?lighter 'lighter')) (or (not (Is ?controller 'game_controller')) (RightOf ?lighter ?controller)) (or (not (Is ?controller 'game_controller')) (AlignedHorizontally ?controller ?lighter))))))",
    "k": 3,
