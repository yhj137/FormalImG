    "cnf": "(forall ?tie (exists ?monitor (exists ?plate (exists ?handbag (and (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (Is ?monitor 'monitor')) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (Is ?plate 'plate')) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (Above ?tie ?monitor)) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (Is ?handbag 'handbag')) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (Above ?monitor ?plate)) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (Above ?plate ?handbag)) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (AlignedVertically ?tie ?monitor)) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (AlignedVertically ?monitor ?plate)) (or (not (Is ?tie 'tie')) (not (OnTopSide ?tie)) (AlignedVertically ?plate ?handbag)))))))",
    "k": 4,
    "object_classes": [
        "monitor",
        "plate",
        "handbag",
        "tie"
    ]
