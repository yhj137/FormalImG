    "cnf": "(exists ?d (exists ?s (forall ?w (exists ?p (exists ?c (and (Is ?d 'drill') (Above ?d ?s) (Is ?s 'screwdriver') (or (not (Is ?w 'wrench')) (Above ?s ?w)) (or (not (Is ?w 'wrench')) (Is ?c 'cup')) (or (not (Is ?w 'wrench')) (AlignedHorizontally ?w ?p)) (or (not (Is ?w 'wrench')) (Is ?p 'pizza')) (or (not (Is ?w 'wrench')) (Above ?p ?c)) (or (not (Is ?w 'wrench')) (OnRightSide ?c))))))))",
    "k": 5,
    "object_classes": [
