    "cnf": "(forall ?book (exists ?pen (exists ?scissors (exists ?mouse (exists ?shoe (exists ?spoon (and (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Is ?pen 'pen')) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Below ?pen ?book)) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Is ?scissors 'scissors')) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (AlignedVertically ?book ?pen)) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Is ?spoon 'spoon')) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Is ?mouse 'mouse')) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (RightOf ?scissors ?pen)) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Has ?shoe 'blue')) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (LeftOf ?shoe ?spoon)) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Is ?shoe 'shoe')) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (RightOf ?mouse ?scissors)) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (Below ?shoe ?pen)) (or (not (Is ?book 'book')) (not (Has ?book 'red')) (AlignedVertically ?pen ?shoe)))))))))",
    "k": 6,
