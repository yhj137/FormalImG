    "dsl": "(exists ?backpack (exists ?pizza (exists ?camera (exists ?pliers (and (Is ?backpack 'backpack') (Is ?pizza 'pizza') (Is ?camera 'camera') (Is ?pliers 'pliers') (LargerThan ?backpack ?pizza) (SmallerThan ?camera ?pizza) (LargerThan ?camera ?pliers) (OnRightSide ?pliers))))))",
    "cnf": "(exists ?backpack (exists ?pizza (exists ?camera (exists ?pliers (and (Is ?backpack 'backpack') (LargerThan ?backpack ?pizza) (Is ?pizza 'pizza') (SmallerThan ?camera ?pizza) (Is ?camera 'camera') (LargerThan ?camera ?pliers) (Is ?pliers 'pliers') (OnRightSide ?pliers))))))",
    "k": 4,
