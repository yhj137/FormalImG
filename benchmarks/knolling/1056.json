    "dsl": "(forall ?shoe (implies (Is ?shoe 'shoe') (exists ?glasses (exists ?carrot (exists ?stapler (exists ?pliers (exists ?apple (and (Is ?glasses 'glasses') (Is ?carrot 'carrot') (Is ?stapler 'stapler') (Is ?pliers 'pliers') (Is ?apple 'apple') (OnBottomSide ?carrot) (LeftOf ?glasses ?shoe) (LeftOf ?carrot ?glasses) (RightOf ?stapler ?shoe) (RightOf ?pliers ?stapler) (RightOf ?apple ?pliers) (OnRightSide ?apple)))))))))",
