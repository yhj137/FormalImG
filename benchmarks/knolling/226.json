    "dsl": "(exists ?hat (exists ?pliers (and (Is ?hat 'hat') (Has ?hat 'blue') (Is ?pliers 'pliers') (Has ?pliers 'red') (LargerThan ?hat ?pliers))))",
    "cnf": "(exists ?hat (exists ?pliers (and (Is ?hat 'hat') (Has ?hat 'blue') (LargerThan ?hat ?pliers) (Has ?pliers 'red') (Is ?pliers 'pliers'))))",
    "k": 2,
    "object_classes": [
        "hat",
        "pliers"
    ]
