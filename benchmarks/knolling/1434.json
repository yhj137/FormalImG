    "cnf": "(forall ?plate (exists ?spoon (exists ?lemon (exists ?remote (exists ?calculator (exists ?pliers (exists ?scissors (exists ?wrench (and (or (not (Is ?plate 'plate')) (OnTopSide ?plate)) (or (not (Is ?plate 'plate')) (Is ?spoon 'spoon')) (or (not (Is ?plate 'plate')) (Is ?lemon 'lemon')) (or (not (Is ?plate 'plate')) (RightOf ?spoon ?plate)) (or (not (Is ?plate 'plate')) (Is ?remote 'remote')) (or (not (Is ?plate 'plate')) (RightOf ?lemon ?spoon)) (or (not (Is ?plate 'plate')) (Is ?wrench 'wrench')) (or (not (Is ?plate 'plate')) (Is ?calculator 'calculator')) (or (not (Is ?plate 'plate')) (Above ?plate ?remote)) (or (not (Is ?plate 'plate')) (SmallerThan ?spoon ?plate)) (or (not (Is ?plate 'plate')) (SmallerThan ?lemon ?plate)) (or (not (Is ?plate 'plate')) (Is ?scissors 'scissors')) (or (not (Is ?plate 'plate')) (Above ?pliers ?wrench)) (or (not (Is ?plate 'plate')) (Is ?pliers 'pliers')) (or (not (Is ?plate 'plate')) (Above ?remote ?calculator)) (or (not (Is ?plate 'plate')) (RightOf ?scissors ?pliers)) (or (not (Is ?plate 'plate')) (RightOf ?pliers ?remote)))))))))))",
