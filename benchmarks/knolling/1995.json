    "cnf": "(exists ?handbag (exists ?shoe (exists ?wallet (exists ?bowl (exists ?calculator (exists ?glasses (exists ?knife (exists ?spoon (exists ?sock (forall ?pliers (and (Is ?handbag 'handbag') (OnTopSide ?handbag) (LeftOf ?handbag ?shoe) (AlignedHorizontally ?handbag ?shoe) (Is ?shoe 'shoe') (LeftOf ?shoe ?wallet) (or (not (Is ?pliers 'pliers')) (LeftOf ?pliers ?handbag)) (AlignedHorizontally ?shoe ?wallet) (Is ?wallet 'wallet') (SmallerThan ?wallet ?calculator) (AlignedHorizontally ?calculator ?glasses) (AlignedHorizontally ?bowl ?calculator) (LeftOf ?calculator ?glasses) (SmallerThan ?glasses ?knife) (LeftOf ?bowl ?calculator) (Is ?glasses 'glasses') (AlignedHorizontally ?knife ?spoon) (OnBottomSide ?bowl) (Is ?calculator 'calculator') (LeftOf ?knife ?spoon) (LeftOf ?spoon ?sock) (AlignedHorizontally ?spoon ?sock) (Is ?bowl 'bowl') (Is ?knife 'knife') (Is ?spoon 'spoon') (Is ?sock 'sock') (OnRightSide ?sock))))))))))))",
