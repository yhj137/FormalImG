{
    "prompt": "In this image, all directions are relative to the frame. A pixel art scene where every phone has a dirty spoon to its right.",
    "dsl": "(and (IsStyle 'pixel art') (forall ?p (implies (Is ?p 'phone') (exists ?s (and (Is ?s 'spoon') (HasState ?s 'dirty') (RightOf ?s ?p))))))",
