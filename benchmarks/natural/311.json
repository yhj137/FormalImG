{
    "prompt": "A photo where every man is holding a dirty hat.",
    "dsl": "(and (IsStyle 'photo') (forall ?m (implies (Is ?m 'man') (exists ?h (and (Is ?h 'hat') (HasState ?h 'dirty') (Holding ?m ?h))))))",
