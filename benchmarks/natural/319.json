{
    "prompt": "This is a pixel art image. Every bird in the scene is holding a red fruit.",
    "dsl": "(and (IsStyle 'pixel art') (forall ?b (implies (Is ?b 'bird') (exists ?f (and (Is ?f 'fruit') (HasColor ?f 'red') (Holding ?b ?f))))))",
    "cnf": "(and (IsStyle 'pixel art') (forall ?b (exists ?f (and (or (not (Is ?b 'bird')) (Is ?f 'fruit')) (or (not (Is ?b 'bird')) (HasColor ?f 'red')) (or (not (Is ?b 'bird')) (Holding ?b ?f))))))",
    "k": 2,
    "object_classes": [
        "bird",
        "fruit"
    ]
}