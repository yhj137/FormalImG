{
    "prompt": "In this image, all directions are relative to the frame. A cyberpunk style scene featuring a refrigerator. Every bowl is round and positioned next to the refrigerator.",
    "dsl": "(and (IsStyle 'cyberpunk') (exists ?r (and (Is ?r 'refrigerator') (forall ?b (implies (Is ?b 'bowl') (and (HasShape ?b 'round') (NextTo ?b ?r)))))))",
