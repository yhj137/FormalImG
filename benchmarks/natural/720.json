    "dsl": "(and (IsStyle 'cyberpunk') (exists ?r (exists ?ch (and (Is ?r 'rock') (Is ?ch 'chair') (RightOf ?ch ?r) (forall ?f (implies (Is ?f 'fish') (LeftOf ?f ?r))) (exists ?c (and (Is ?c 'car') (HasColor ?c 'blue') (RightOf ?c ?ch)))))))",
