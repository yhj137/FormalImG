{
    "prompt": "In this image, all directions are relative to the frame. A cartoon style scene featuring a round rock next to a man. Every phone rests on the rock to the left of the man.",
    "dsl": "(and (IsStyle 'cartoon') (exists ?r (exists ?m (and (Is ?r 'rock') (HasShape ?r 'round') (Is ?m 'man') (NextTo ?r ?m) (forall ?p (implies (Is ?p 'phone') (and (On ?p ?r) (LeftOf ?p ?m))))))))",
    "cnf": "(and (IsStyle 'cartoon') (exists ?r (exists ?m (forall ?p (and (Is ?r 'rock') (HasShape ?r 'round') (NextTo ?r ?m) (or (not (Is ?p 'phone')) (On ?p ?r)) (Is ?m 'man') (or (not (Is ?p 'phone')) (LeftOf ?p ?m)))))))",
    "k": 3,
    "object_classes": [
        "man",
        "phone",
        "rock"
    ]
}