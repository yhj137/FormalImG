{
    "prompt": "In this image, all directions are relative to the frame. A cyberpunk style scene where every sofa has a sliced cake on it.",
    "dsl": "(and (IsStyle 'cyberpunk') (forall ?s (implies (Is ?s 'sofa') (exists ?c (and (Is ?c 'cake') (HasState ?c 'sliced') (On ?c ?s))))))",
