    "dsl": "(and (IsStyle 'photo') (exists ?w (exists ?s (exists ?sp (and (Is ?w 'wardrobe') (HasMaterial ?w 'wooden') (Is ?s 'sofa') (HasColor ?s 'red') (NextTo ?w ?s) (Is ?sp 'spoon') (HasMaterial ?sp 'metal') (LeftOf ?sp ?s) (forall ?t (implies (Is ?t 'teddy bear') (RightOf ?t ?w))))))))",
