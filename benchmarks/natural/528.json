    "dsl": "(exists ?b (and (Is ?b 'bench') (HasMaterial ?b 'wooden') (forall ?s (implies (Is ?s 'spoon') (and (On ?s ?b) (exists ?w (and (Is ?w 'woman') (NextTo ?w ?b) (Holding ?w ?s))))))))",
