    "dsl": "(and (IsStyle 'oil painting') (exists ?w (and (Is ?w 'wardrobe') (HasMaterial ?w 'wooden') (exists ?l (and (Is ?l 'laptop') (In ?l ?w) (forall ?b (implies (Is ?b 'banana') (LeftOf ?b ?w))) (exists ?bi (and (Is ?bi 'bird') (LeftOf ?bi ?l))))))))",
