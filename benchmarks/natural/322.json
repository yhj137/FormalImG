{
    "prompt": "In this image, all directions are relative to the frame. A photo showing a metal spoon inside every bowl.",
    "dsl": "(and (IsStyle 'photo') (forall ?b (implies (Is ?b 'bowl') (exists ?s (and (Is ?s 'spoon') (HasMaterial ?s 'metal') (In ?s ?b))))))",
