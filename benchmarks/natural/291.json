{
    "prompt": "In this image, all directions are relative to the frame. A cartoon style image with an oval mirror to the right of every elephant.",
    "dsl": "(and (IsStyle 'cartoon') (forall ?e (implies (Is ?e 'elephant') (exists ?m (and (Is ?m 'mirror') (HasShape ?m 'oval') (RightOf ?m ?e))))))",
    "cnf": "(and (IsStyle 'cartoon') (forall ?e (exists ?m (and (or (not (Is ?e 'elephant')) (Is ?m 'mirror')) (or (not (Is ?e 'elephant')) (HasShape ?m 'oval')) (or (not (Is ?e 'elephant')) (RightOf ?m ?e))))))",
    "k": 2,
    "object_classes": [
        "mirror",
        "elephant"
    ]
}