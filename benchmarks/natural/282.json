{
    "prompt": "In this image, all directions are relative to the frame. An oil painting where every flower has a closed book to its left.",
    "dsl": "(and (IsStyle 'oil painting') (forall ?f (implies (Is ?f 'flower') (exists ?b (and (Is ?b 'book') (HasState ?b 'closed') (LeftOf ?b ?f))))))",
