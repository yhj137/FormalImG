    "dsl": "(and (IsStyle 'pixel art') (exists ?c (and (Is ?c 'child') (forall ?t (implies (Is ?t 'tree') (NextTo ?c ?t))) (exists ?b (and (Is ?b 'basket') (HasColor ?b 'brown') (Holding ?c ?b))))))",
