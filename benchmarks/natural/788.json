    "dsl": "(and (IsStyle 'pixel art') (exists ?t (exists ?k (exists ?g (and (Is ?t 'table') (Is ?k 'keyboard') (Is ?g 'glasses') (HasShape ?g 'round') (LeftOf ?k ?t) (NextTo ?g ?k) (forall ?f (implies (Is ?f 'fish') (RightOf ?f ?t))))))))",
