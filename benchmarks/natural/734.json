    "dsl": "(and (IsStyle 'oil painting') (exists ?r (and (Is ?r 'rug') (HasColor ?r 'red') (exists ?b (and (Is ?b 'basket') (NextTo ?b ?r) (forall ?k (implies (Is ?k 'key') (In ?k ?b))) (exists ?h (and (Is ?h 'hammer') (RightOf ?h ?b))))))))",
