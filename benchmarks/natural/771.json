    "dsl": "(and (IsStyle 'cyberpunk') (exists ?m (exists ?l (exists ?s (and (Is ?m 'man') (Is ?l 'laptop') (HasShape ?l 'rectangular') (Holding ?m ?l) (Is ?s 'shoes') (HasColor ?s 'red') (NextTo ?s ?m) (forall ?b (implies (Is ?b 'butterfly') (RightOf ?b ?m))))))))",
