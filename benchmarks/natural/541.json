    "dsl": "(and (IsStyle 'cartoon') (exists ?b (and (Is ?b 'bus') (forall ?f (implies (Is ?f 'butterfly') (On ?f ?b))) (exists ?a (and (Is ?a 'apple') (HasShape ?a 'round') (LeftOf ?a ?b))))))",
