    "dsl": "(and (IsStyle 'oil painting') (exists ?c (exists ?j (and (Is ?c 'child') (Is ?j 'jacket') (NextTo ?j ?c) (forall ?s (implies (Is ?s 'screwdriver') (and (HasShape ?s 'cylindrical') (In ?s ?j) (RightOf ?s ?c))))))))",
