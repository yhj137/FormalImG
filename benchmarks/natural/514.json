    "dsl": "(and (IsStyle 'pixel art') (exists ?w (and (Is ?w 'wardrobe') (HasShape ?w 'rectangular') (forall ?b (implies (Is ?b 'backpack') (and (On ?b ?w) (exists ?l (and (Is ?l 'lion') (NextTo ?l ?b)))))))))",
