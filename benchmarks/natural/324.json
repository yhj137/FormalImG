{
    "prompt": "An oil painting where every person is holding a rectangular laptop.",
    "dsl": "(and (IsStyle 'oil painting') (forall ?p (implies (Is ?p 'person') (exists ?l (and (Is ?l 'laptop') (HasShape ?l 'rectangular') (Holding ?p ?l))))))",
    "cnf": "(and (IsStyle 'oil painting') (forall ?p (exists ?l (and (or (not (Is ?p 'person')) (Is ?l 'laptop')) (or (not (Is ?p 'person')) (HasShape ?l 'rectangular')) (or (not (Is ?p 'person')) (Holding ?p ?l))))))",
    "k": 2,
    "object_classes": [
        "laptop",
        "person"
    ]
}