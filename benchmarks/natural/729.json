    "dsl": "(and (IsStyle 'photo') (exists ?c (exists ?m (and (Is ?c 'child') (Is ?m 'monitor') (HasState ?m 'on') (NextTo ?c ?m) (forall ?b (implies (Is ?b 'ball') (and (HasMaterial ?b 'plastic') (LeftOf ?b ?m)))) (exists ?d (and (Is ?d 'dog') (Holding ?c ?d)))))))",
