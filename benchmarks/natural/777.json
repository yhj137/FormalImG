    "dsl": "(and (IsStyle 'cyberpunk') (exists ?p (exists ?l (exists ?k (and (Is ?p 'person') (Is ?l 'laptop') (HasState ?l 'on') (NextTo ?l ?p) (Is ?k 'key') (HasMaterial ?k 'metal') (NextTo ?k ?l) (forall ?f (implies (Is ?f 'flower') (LeftOf ?f ?p))))))))",
