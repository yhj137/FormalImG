{
    "prompt": "In this image, all directions are relative to the frame. A cyberpunk scene features a monitor that is turned on. All butterflies are positioned to the right of the monitor, while a toy car sits next to the monitor on the left.",
    "dsl": "(and (IsStyle 'cyberpunk') (exists ?m (and (Is ?m 'monitor') (HasState ?m 'on') (forall ?b (implies (Is ?b 'butterfly') (RightOf ?b ?m))) (exists ?t (and (Is ?t 'toy car') (NextTo ?t ?m) (LeftOf ?t ?m))))))",
    "cnf": "(and (IsStyle 'cyberpunk') (exists ?m (forall ?b (exists ?t (and (Is ?m 'monitor') (HasState ?m 'on') (or (not (Is ?b 'butterfly')) (RightOf ?b ?m)) (NextTo ?t ?m) (LeftOf ?t ?m) (Is ?t 'toy car'))))))",
    "k": 3,
    "object_classes": [
        "butterfly",
        "monitor",
        "toy car"
    ]
}