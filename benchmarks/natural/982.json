    "dsl": "(and (IsStyle 'cyberpunk') (exists ?b (exists ?w (exists ?bp (exists ?h (and (Is ?b 'boat') (HasMaterial ?b 'metal') (Is ?w 'woman') (On ?w ?b) (Is ?bp 'backpack') (Holding ?w ?bp) (Is ?h 'hat') (LeftOf ?h ?w) (forall ?f (implies (Is ?f 'flower') (On ?f ?b)))))))))",
