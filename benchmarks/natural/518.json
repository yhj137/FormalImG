    "dsl": "(and (IsStyle 'cartoon') (exists ?j (and (Is ?j 'jacket') (HasState ?j 'open') (forall ?f (implies (Is ?f 'fruit') (LeftOf ?f ?j))) (exists ?b (and (Is ?b 'bottle') (HasState ?b 'empty') (In ?b ?j))))))",
