    "dsl": "(and (IsStyle 'cyberpunk') (exists ?k (and (Is ?k 'keyboard') (HasColor ?k 'black') (forall ?t (implies (Is ?t 'teddy bear') (and (HasColor ?t 'blue') (On ?t ?k)))))))",
