{
    "prompt": "In this image, all directions are relative to the frame. A cyberpunk style scene featuring a rectangular sofa, with every cat sitting on it.",
    "dsl": "(and (IsStyle 'cyberpunk') (exists ?s (and (Is ?s 'sofa') (HasShape ?s 'rectangular') (forall ?c (implies (Is ?c 'cat') (On ?c ?s))))))",
