{
    "prompt": "In this image, all directions are relative to the frame. An oil painting style scene where every screwdriver is inside a green plant.",
    "dsl": "(and (IsStyle 'oil painting') (forall ?s (implies (Is ?s 'screwdriver') (exists ?p (and (Is ?p 'plant') (HasColor ?p 'green') (In ?s ?p))))))",
