{
    "prompt": "An oil painting where every plant is held by a smiling woman.",
    "dsl": "(and (IsStyle 'oil painting') (forall ?p (implies (Is ?p 'plant') (exists ?w (and (Is ?w 'woman') (HasState ?w 'smiling') (Holding ?w ?p))))))",
