    "dsl": "(and (IsStyle 'pixel art') (exists ?d (exists ?g (exists ?k (and (Is ?d 'desk') (Is ?g 'dog') (HasColor ?g 'black') (In ?g ?d) (Is ?k 'knife') (Holding ?g ?k) (forall ?c (implies (Is ?c 'chair') (NextTo ?c ?d))))))))",
