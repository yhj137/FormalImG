{
    "prompt": "In this image, all directions are relative to the frame. A cyberpunk scene features a rusty bus containing every cup. A bed sits to the left of the bus, and a blue boat is to its right.",
    "dsl": "(and (IsStyle 'cyberpunk') (exists ?b (and (Is ?b 'bus') (HasState ?b 'rusty') (forall ?c (implies (Is ?c 'cup') (In ?c ?b))) (exists ?bed (and (Is ?bed 'bed') (LeftOf ?bed ?b))) (exists ?boat (and (Is ?boat 'boat') (HasColor ?boat 'blue') (RightOf ?boat ?b))))))",
    "cnf": "(and (IsStyle 'cyberpunk') (exists ?b (forall ?c (exists ?bed (exists ?boat (and (Is ?b 'bus') (HasState ?b 'rusty') (or (not (Is ?c 'cup')) (In ?c ?b)) (LeftOf ?bed ?b) (RightOf ?boat ?b) (Is ?bed 'bed') (HasColor ?boat 'blue') (Is ?boat 'boat')))))))",
    "k": 4,
    "object_classes": [
        "boat",
        "bed",
        "bus",
        "cup"
    ]
}