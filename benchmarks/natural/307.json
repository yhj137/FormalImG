{
    "prompt": "In this image, all directions are relative to the frame. A cartoon style image where every elephant wears a yellow hat.",
    "dsl": "(and (IsStyle 'cartoon') (forall ?e (implies (Is ?e 'elephant') (exists ?h (and (Is ?h 'hat') (HasColor ?h 'yellow') (On ?h ?e))))))",
