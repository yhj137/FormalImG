{
    "prompt": "In this image, all directions are relative to the frame. A pixel art scene featuring a blue fish, with every pizza placed next to it.",
    "dsl": "(and (IsStyle 'pixel art') (exists ?f (and (Is ?f 'fish') (HasColor ?f 'blue') (forall ?p (implies (Is ?p 'pizza') (NextTo ?p ?f))))))",
    "cnf": "(and (IsStyle 'pixel art') (exists ?f (forall ?p (and (Is ?f 'fish') (HasColor ?f 'blue') (or (not (Is ?p 'pizza')) (NextTo ?p ?f))))))",
    "k": 2,
    "object_classes": [
        "pizza",
        "fish"
    ]
}