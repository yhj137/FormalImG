    "dsl": "(and (IsStyle 'cartoon') (exists ?bs (and (Is ?bs 'bookshelf') (forall ?bo (implies (Is ?bo 'bottle') (On ?bo ?bs))) (exists ?d (exists ?s (and (Is ?d 'dog') (Is ?s 'shoes') (HasState ?d 'sitting') (LeftOf ?d ?bs) (Holding ?d ?s)))))))",
