{
    "prompt": "An oil painting where every bird holds a round cake.",
    "dsl": "(and (IsStyle 'oil painting') (forall ?b (implies (Is ?b 'bird') (exists ?c (and (Is ?c 'cake') (HasShape ?c 'round') (Holding ?b ?c))))))",
