{
    "prompt": "In this image, all directions are relative to the frame. A cartoon style scene featuring a car. Every keyboard is positioned to the right of the car. Inside the car, a man holds a round, sliced pizza.",
    "dsl": "(and (IsStyle 'cartoon') (exists ?c (and (Is ?c 'car') (forall ?k (implies (Is ?k 'keyboard') (RightOf ?k ?c))) (exists ?m (and (Is ?m 'man') (In ?m ?c) (exists ?p (and (Is ?p 'pizza') (HasShape ?p 'round') (HasState ?p 'sliced') (Holding ?m ?p))))))))",
    "cnf": "(and (IsStyle 'cartoon') (exists ?c (forall ?k (exists ?m (exists ?p (and (Is ?c 'car') (or (not (Is ?k 'keyboard')) (RightOf ?k ?c)) (In ?m ?c) (Is ?m 'man') (Holding ?m ?p) (HasState ?p 'sliced') (HasShape ?p 'round') (Is ?p 'pizza')))))))",
    "k": 4,
    "object_classes": [
        "keyboard",
        "pizza",
        "man",
        "car"
    ]
}