    "dsl": "(and (IsStyle 'cartoon') (exists ?b (exists ?f (and (Is ?b 'bed') (HasMaterial ?b 'wooden') (Is ?f 'fork') (On ?f ?b) (forall ?s (implies (Is ?s 'shoes') (RightOf ?s ?b)))))))",
