{
    "prompt": "In this image, all directions are relative to the frame. A photo of an oval spoon with every butterfly inside it.",
    "dsl": "(and (IsStyle 'photo') (exists ?s (and (Is ?s 'spoon') (HasShape ?s 'oval') (forall ?b (implies (Is ?b 'butterfly') (In ?b ?s))))))",
    "cnf": "(and (IsStyle 'photo') (exists ?s (forall ?b (and (Is ?s 'spoon') (HasShape ?s 'oval') (or (not (Is ?b 'butterfly')) (In ?b ?s))))))",
    "k": 2,
    "object_classes": [
        "butterfly",
        "spoon"
    ]
}