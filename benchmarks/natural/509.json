    "dsl": "(and (IsStyle 'pixel art') (exists ?w (and (Is ?w 'woman') (HasState ?w 'standing') (forall ?b (implies (Is ?b 'banana') (and (HasState ?b 'peeled') (RightOf ?b ?w)))) (exists ?p (and (Is ?p 'person') (NextTo ?p ?w) (LeftOf ?p ?w))))))",
